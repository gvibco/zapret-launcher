<Window x:Class="ZapretLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZapretLauncher.App.ViewModels"
        xmlns:views="clr-namespace:ZapretLauncher.App.Views"
        Title="Zapret Launcher" Width="1080" Height="720"
        MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StatusViewModel}">
            <views:StatusView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrategiesViewModel}">
            <views:StrategiesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CoverageViewModel}">
            <views:CoverageView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView/></DataTemplate>

        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#C7D4EE"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <Border Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShieldCheck}" Width="15" Height="15"
                          Stretch="Uniform" Stroke="{DynamicResource Accent}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <TextBlock Text="Zapret Launcher" Foreground="#C7D4EE" FontSize="12"
                               FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                            ToolTip="Свернуть">
                        <Path Data="M5 12 H19" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click"
                            ToolTip="Развернуть">
                        <Path Data="M5 5 H19 V19 H5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform"
                              StrokeLineJoin="Round"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click"
                            ToolTip="Закрыть">
                        <Path Data="M6 6 L18 18 M18 6 L6 18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource SidebarBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,22,18,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="12"
                                    Background="{DynamicResource AccentGradient}">
                                <Path Data="{StaticResource IconShieldCheck}"
                                      Width="21" Height="21"
                                      Stretch="Uniform"
                                      Stroke="White"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Zapret Launcher" Foreground="White"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Обход блокировок" Foreground="#8394B8"
                                           FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="Nav" Margin="12,4,12,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource SidebarText}"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="Nav_SelectionChanged">
                        <ListBoxItem Tag="status" IsSelected="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconPulse}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Статус" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="strategies">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconLayers}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Стратегии" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="coverage">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconGlobe}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Покрытие" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="diagnostics">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconShieldCheck}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Проверка" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconSliders}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Настройки" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="logs">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon20}" Data="{StaticResource IconTerminal}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Text="Логи" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border Grid.Row="2" Margin="16,0,16,18"
                            Background="#12FFFFFF" BorderBrush="#1AFFFFFF"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status.IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="#C7D4EE" FontSize="12" FontWeight="SemiBold"
                                           Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Обход выключен"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status.IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="Обход включён"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Status.EngineVersion, StringFormat=Движок {0}}"
                                       Foreground="#8394B8" FontSize="11" Margin="15,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" ClipToBounds="True">
                <Ellipse Width="560" Height="560" IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-260,-180,0"
                         Fill="{DynamicResource GlowBrush}"/>
                <ContentControl Content="{Binding SelectedContent}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
