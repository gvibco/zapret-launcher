<UserControl x:Class="ZapretLauncher.App.Views.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Стратегии" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Выберите способ обхода или прогоните тест всех стратегий."
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding TestAllCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlay}"
                              Stroke="{DynamicResource AccentText}"/>
                        <TextBlock Text="Тест всех" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Content="Отмена" Command="{Binding CancelTestCommand}"
                        IsEnabled="{Binding IsTesting}" Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,8,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Все стратегии" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Strategies.Count, StringFormat={}{0} шт.}"
                                   Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Strategies}"
                             SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Modes}" Style="{StaticResource HintText}"
                                                   FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Pill}"
                                            Background="{DynamicResource PanelBackgroundAlt}"
                                            Padding="9,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Score, Converter={StaticResource ScoreToBrush}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Выбранная стратегия" Style="{StaticResource HintText}"/>
                            <TextBlock Text="{Binding Selected.Name}" FontSize="24" FontWeight="SemiBold"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Selected.Modes}" Style="{StaticResource MetaText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="16,0,0,0">
                            <Border Style="{StaticResource Pill}"
                                    Background="{DynamicResource SelectedBackground}"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Счёт " Style="{StaticResource HintText}"/>
                                    <TextBlock Text="{Binding Selected.Score}" FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{Binding Selected.Score, Converter={StaticResource ScoreToBrush}}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Selected.TestedAt, StringFormat=Проверено: {0}}"
                                       Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding Selected.TestedAt, Converter={StaticResource NotEmptyToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Divider}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Command="{Binding RunSelectedCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}"
                                      Stroke="{DynamicResource AccentText}"/>
                                <TextBlock Text="Запустить" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CopyArgsCommand}" Style="{StaticResource GhostButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconCopy}"
                                      Stroke="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="Копировать" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Аргументы winws" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
                        <Border Grid.Row="1" Style="{StaticResource CardAlt}" Padding="4"
                                Background="{DynamicResource InputBackground}">
                            <TextBox Text="{Binding ArgsPreview, Mode=OneWay}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     MinHeight="150"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardAlt}" Margin="0,12,0,0" Padding="13,11"
                Visibility="{Binding ProgressText, Converter={StaticResource NotEmptyToVis}}">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconPulse}"
                      Stroke="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding ProgressText}" Margin="10,0,0,0" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
