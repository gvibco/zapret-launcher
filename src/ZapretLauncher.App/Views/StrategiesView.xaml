<UserControl x:Class="ZapretLauncher.App.Views.StrategiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Стратегии" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="Тест всех" Command="{Binding TestAllCommand}"
                    Margin="24,0,8,0" Padding="14,8"/>
            <Button Content="Отмена" Command="{Binding CancelTestCommand}"
                    IsEnabled="{Binding IsTesting}" Padding="14,8"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Selected}"
                     DisplayMemberPath="Name"/>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Selected.Modes}" Foreground="#666" Margin="0,4,0,8"/>
                <TextBlock Text="{Binding Selected.Score, StringFormat=Счёт: {0}}"/>
                <TextBlock Text="{Binding Selected.TestedAt}" Foreground="#666" Margin="0,0,0,12"/>
                <Button Content="Запустить выбранную" Command="{Binding RunSelectedCommand}"
                        HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,12"/>
                <TextBlock Text="Аргументы winws" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Button Content="Скопировать" Command="{Binding CopyArgsCommand}"
                        HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ArgsPreview, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" Height="260"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
