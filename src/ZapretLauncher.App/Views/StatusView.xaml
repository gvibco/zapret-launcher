<UserControl x:Class="ZapretLauncher.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,30" MaxWidth="1120">

            <TextBlock Text="Статус" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Состояние обхода и доступность сервисов в вашей сети."
                       Style="{StaticResource PageSubtitle}"/>

            <!-- Первый запуск -->
            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,12"
                    Background="{DynamicResource InfoSoft}"
                    BorderBrush="#3D5BC8FF" BorderThickness="1"
                    Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource Icon20}" Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource Info}"/>
                    <TextBlock Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Движок распакован. Перейдите в «Стратегии» и нажмите «Тест всех», чтобы выбрать рабочую стратегию."/>
                    <Button Grid.Column="2" Content="Понятно" Style="{StaticResource SmallButton}"
                            Command="{Binding DismissFirstRunCommand}"/>
                </Grid>
            </Border>

            <!-- Hero -->
            <Border Style="{StaticResource HeroCard}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12"
                                             Fill="{DynamicResource Success}" Opacity="0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="PulseStoryboard">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.35" To="0" Duration="0:0:1.6"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Ellipse Width="8" Height="8">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                                <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Обход выключен"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="Обход включён"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CurrentStrategyName}" FontSize="30" FontWeight="SemiBold"
                                   Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Текущая стратегия обхода" Style="{StaticResource MetaText}"
                                   Margin="0,3,0,0"/>

                        <WrapPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconBolt}"
                                      Stroke="{DynamicResource Accent}"/>
                                <TextBlock Style="{StaticResource MetaText}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding EngineVersion, StringFormat=Движок {0}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconWifi}"
                                      Stroke="{DynamicResource Info}"/>
                                <TextBlock Style="{StaticResource MetaText}" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding NetworkName, StringFormat=Сеть: {0}}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShield}"
                                      Stroke="{DynamicResource Success}"/>
                                <TextBlock Style="{StaticResource MetaText}" Margin="7,0,0,0"
                                           VerticalAlignment="Center" Text="{Binding AdminText}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="210" Margin="26,0,0,0">
                        <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}"
                                Style="{StaticResource PrimaryButton}" Height="48" FontSize="14"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Text="Один клик — и трафик идёт напрямую"
                                   Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" Margin="0,9,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Сервисы -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlay}"
                                  Stroke="{DynamicResource Danger}"/>
                            <TextBlock Text="YouTube" Style="{StaticResource MetaText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding YouTubeStatus}" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   Foreground="{Binding YouTubeStatus, Converter={StaticResource RatioToBrush}}"/>
                        <TextBlock Text="пройдено проверок" Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconWifi}"
                                  Stroke="{DynamicResource Accent}"/>
                            <TextBlock Text="Discord" Style="{StaticResource MetaText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DiscordStatus}" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   Foreground="{Binding DiscordStatus, Converter={StaticResource RatioToBrush}}"/>
                        <TextBlock Text="пройдено проверок" Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconGlobe}"
                                  Stroke="{DynamicResource Info}"/>
                            <TextBlock Text="Google" Style="{StaticResource MetaText}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GoogleStatus}" FontSize="22" FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   Foreground="{Binding GoogleStatus, Converter={StaticResource RatioToBrush}}"/>
                        <TextBlock Text="пройдено проверок" Style="{StaticResource HintText}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Действия -->
            <WrapPanel Margin="0,16,0,0">
                <Button Command="{Binding CheckNowCommand}" Margin="0,0,8,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}"
                              Stroke="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Проверить сейчас" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RequestTestAllCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlay}"
                              Stroke="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Прогнать тест" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshDiagnosticsCommand}" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShieldCheck}"
                              Stroke="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Обновить диагностику" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <Border Style="{StaticResource CardAlt}" Margin="0,2,0,0" Padding="13,11"
                    Visibility="{Binding CheckSummary, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconPulse}"
                          Stroke="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding CheckSummary}" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardAlt}" Margin="0,10,0,0" Padding="13,11"
                    Background="{DynamicResource InfoSoft}" BorderBrush="#3D5BC8FF"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource Info}"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Предупреждения -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,14"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconWarning}"
                              Stroke="{DynamicResource Warning}"/>
                        <TextBlock Text="Предупреждения" Style="{StaticResource SectionTitle}"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Warning}"
                                             VerticalAlignment="Top" Margin="3,7,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}" Margin="11,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="16,14"
                    Background="{DynamicResource SuccessSoft}"
                    BorderBrush="#333DDC97" BorderThickness="1"
                    Visibility="{Binding HasWarnings, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconCheck}"
                          Stroke="{DynamicResource Success}"/>
                    <TextBlock Text="Проверки пройдены. Предупреждений нет." Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
