<UserControl x:Class="ZapretLauncher.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,30" MaxWidth="1120">

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Проверка" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Права, драйверы, службы и доступность сайтов."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconShieldCheck}"
                                  Stroke="{DynamicResource AccentText}"/>
                            <TextBlock Text="Проверить" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconCopy}"
                                  Stroke="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Скопировать отчёт" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16,13">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Проверки" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Конфигурация Windows и движка" Style="{StaticResource HintText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Checks}" Margin="0,4,0,0"
                             >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0"
                                             Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Grid.Column="1" FontSize="11"
                                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="10,2,10,0"
                                               Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Message}"
                                               Style="{StaticResource MetaText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,13">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Сайты" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Результат реальных запросов через текущую сеть"
                                   Style="{StaticResource HintText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Probes}" Margin="0,4,0,0"
                             >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0"
                                             Fill="{Binding Result, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Top" Margin="10,2,10,0"
                                               Text="{Binding Result, Converter={StaticResource StatusToText}}"
                                               Foreground="{Binding Result, Converter={StaticResource StatusToBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Latency}"
                                               Style="{StaticResource MetaText}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Failure}"
                                               Style="{StaticResource HintText}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardAlt}" Margin="0,14,0,0" Padding="13,11">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconInfo}"
                          Stroke="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
