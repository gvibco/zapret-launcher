<UserControl x:Class="ZapretLauncher.App.Views.CoverageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,30" MaxWidth="1120">

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Покрытие" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Какие сайты и приложения попадают под обход."
                               Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding UpdateListsCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconRefresh}"
                              Stroke="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Обновить списки" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Источники -->
            <Border Style="{StaticResource Card}" Padding="16,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource AccentSoft}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconGlobe}"
                              Stroke="{DynamicResource Accent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Источники списков" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ListsStatus}" Style="{StaticResource MetaText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Свои домены -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Свои домены" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Добавьте сайт, который должен обходиться этим лаунчером."
                               Style="{StaticResource HintText}" Margin="0,3,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Content="Только этот домен"
                                  IsChecked="{Binding NewDomainExact}"
                                  Margin="14,0,12,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding AddDomainCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Добавить" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Domains}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}"/>
                                            <TextBlock Text="{Binding Domain}" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                Padding="8,2" Margin="10,0,6,0"
                                                Background="{DynamicResource AccentSoft}"
                                                Visibility="{Binding Exact, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="точный" FontSize="11"
                                                       Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                ToolTip="Удалить домен"
                                                Command="{Binding DataContext.RemoveDomainCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconTrash}"
                                                  Stroke="{DynamicResource TextMuted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Исключения -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Исключения" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Эти адреса обход не трогает. Полезно для банков и внутренних сервисов."
                               Style="{StaticResource HintText}" Margin="0,3,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding AddExclusionCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Добавить" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Exclusions}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Warning}"/>
                                            <TextBlock Text="{Binding}" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                ToolTip="Удалить исключение"
                                                Command="{Binding DataContext.RemoveExclusionCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconTrash}"
                                                  Stroke="{DynamicResource TextMuted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- IP -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Свои IP и подсети" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Формат: 1.2.3.4 или 10.0.0.0/8."
                               Style="{StaticResource HintText}" Margin="0,3,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewIp, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding AddIpCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Добавить" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Ips}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="0,0,0,1" Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" Fill="{DynamicResource Info}"/>
                                            <TextBlock Text="{Binding}" Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                ToolTip="Удалить адрес"
                                                Command="{Binding DataContext.RemoveIpCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconTrash}"
                                                  Stroke="{DynamicResource TextMuted}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- IPSet -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="IPSet Filter" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Фильтрация по IP-адресам для игр и трафика без SNI."
                               Style="{StaticResource HintText}" Margin="0,3,0,10"/>
                    <ComboBox ItemsSource="{Binding IpsetModes}" SelectedItem="{Binding SelectedIpsetMode}"
                              Width="200" HorizontalAlignment="Left"/>
                    <Border Background="{DynamicResource WarningSoft}" CornerRadius="8"
                            Padding="11,8" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon16}" Data="{StaticResource IconWarning}"
                                  Stroke="{DynamicResource Warning}"/>
                            <TextBlock Text="any может ломать обычные сайты. Используйте для игр и только при необходимости."
                                       Foreground="{DynamicResource Warning}" FontSize="12"
                                       TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Game Filter -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Game Filter" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Порты для UDP-игр. При режиме disabled используется порт 12."
                               Style="{StaticResource HintText}" Margin="0,3,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Режим" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding GameModes}" SelectedItem="{Binding SelectedGameMode}"
                                      Width="140"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TCP-порты" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TcpRange, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="UDP-порты" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding UdpRange, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Формат: 1024-65535 или 1024-1934,1936-65535."
                               Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconCheck}"
                              Stroke="{DynamicResource AccentText}"/>
                        <TextBlock Text="Применить" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
