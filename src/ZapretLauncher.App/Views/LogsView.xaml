<UserControl x:Class="ZapretLauncher.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Логи" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Что происходит с движком и обходом." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="34,8,10,8"/>
                <Path Style="{StaticResource Icon16}" Data="{StaticResource IconSearch}"
                      Stroke="{DynamicResource TextMuted}"
                      HorizontalAlignment="Left" Margin="11,0,0,0"
                      IsHitTestVisible="False"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Command="{Binding ClearCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconTrash}"
                              Stroke="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Очистить" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CopyAllCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconCopy}"
                              Stroke="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Скопировать" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource GhostButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon16}" Data="{StaticResource IconFolder}"
                              Stroke="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Открыть папку" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8"
                Background="{DynamicResource PanelBackgroundAlt}">
            <Grid>
                <ListBox ItemsSource="{Binding Lines}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="NoWrap" Margin="2,1"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVis}}">
                    <Path Data="{StaticResource IconTerminal}" Width="34" Height="34"
                          Stretch="Uniform" Stroke="{DynamicResource TextMuted}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="Пока пусто" FontWeight="SemiBold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Записи появятся после запуска обхода."
                               Style="{StaticResource HintText}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
