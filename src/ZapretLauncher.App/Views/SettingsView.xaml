<UserControl x:Class="ZapretLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <CheckBox Content="Автозапуск при входе" IsChecked="{Binding Settings.Autostart, Mode=TwoWay}" Margin="0,4"/>
            <CheckBox Content="Стартовать свёрнутым" IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" Margin="0,4"/>
            <CheckBox Content="Закрывать в трей" IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}" Margin="0,4"/>
            <Button Content="Применить автозапуск" Command="{Binding ApplyAutostartCommand}"
                    Padding="14,8" HorizontalAlignment="Left" Margin="0,8,0,0"/>

            <TextBlock Text="Свои цели проверки (по одной на строку)" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <TextBox Text="{Binding TargetsText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Открыть папку данных" Command="{Binding OpenDataFolderCommand}" Padding="14,8"/>
            </StackPanel>

            <TextBlock Text="Движок" FontWeight="SemiBold" Margin="0,20,0,6"/>
            <TextBlock Text="{Binding EngineVersion, StringFormat=Версия: {0}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}"
                        Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="Установить обновление" Command="{Binding InstallUpdateCommand}"
                        Padding="14,8"/>
            </StackPanel>
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TextBlock Text="{Binding DataRoot}" Foreground="{DynamicResource TextSecondary}"
                       Margin="0,20,0,0" TextWrapping="Wrap"/>
            <Button Content="Сбросить настройки" Command="{Binding ResetSettingsCommand}"
                    Padding="14,8" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <TextBlock Text="WinDivert может вызывать ложные срабатывания антивируса. Это не вирус; добавляйте исключения только если понимаете риски."
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
