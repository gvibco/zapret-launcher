<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0A0F1E"/>
    <SolidColorBrush x:Key="WindowBackgroundAlt" Color="#0D1426"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#141E33"/>
    <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#101828"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#263450"/>
    <SolidColorBrush x:Key="PanelBorderStrong" Color="#31415F"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0C1428"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#1A2540"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#1A2740"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#1D2E50"/>
    <SolidColorBrush x:Key="NavSelectedBackground" Color="#1B2B4A"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#24FFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F5FF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#98A6C6"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7C8BAE"/>
    <SolidColorBrush x:Key="SidebarText" Color="#B9C6E4"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#4C7DFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6A93FF"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#3A68E0"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#2A4C7DFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Success" Color="#3DDC97"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#223DDC97"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB84D"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#24FFB84D"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#24FF6B6B"/>
    <SolidColorBrush x:Key="Info" Color="#5BC8FF"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#1F5BC8FF"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground" Color="#0F1729"/>
    <SolidColorBrush x:Key="InputBorder" Color="#2A3854"/>
    <SolidColorBrush x:Key="InputBorderHover" Color="#3A4C70"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#2E3C58"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#45577A"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C7DFF" Offset="0"/>
        <GradientStop Color="#35D6E8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6390FF" Offset="0"/>
        <GradientStop Color="#57E2F2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8A4C7DFF" Offset="0"/>
        <GradientStop Color="#4035D6E8" Offset="0.55"/>
        <GradientStop Color="#263450" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGlowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F4C7DFF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.5"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#3D4C7DFF" Offset="0"/>
        <GradientStop Color="#000A0F1E" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
