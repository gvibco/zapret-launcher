<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F6FC"/>
    <SolidColorBrush x:Key="WindowBackgroundAlt" Color="#EAF0FA"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#F7F9FE"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#DCE4F2"/>
    <SolidColorBrush x:Key="PanelBorderStrong" Color="#C6D3E8"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0C1428"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#1A2540"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#EEF3FC"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#E3EBFB"/>
    <SolidColorBrush x:Key="NavSelectedBackground" Color="#1B2B4A"/>
    <SolidColorBrush x:Key="HoverOverlay" Color="#0F000000"/>
    <SolidColorBrush x:Key="PressedOverlay" Color="#1F000000"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#0F1B33"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#57678A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#64718D"/>
    <SolidColorBrush x:Key="SidebarText" Color="#B9C6E4"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="#2F5FE0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#4674F0"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#2449B8"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F2F5FE0"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Success" Color="#0E9F6E"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#1A0E9F6E"/>
    <SolidColorBrush x:Key="Warning" Color="#B4690E"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#1FB4690E"/>
    <SolidColorBrush x:Key="Danger" Color="#D64545"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1FD64545"/>
    <SolidColorBrush x:Key="Info" Color="#1B7DBF"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#1F1B7DBF"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground" Color="#F7F9FE"/>
    <SolidColorBrush x:Key="InputBorder" Color="#D6E0F0"/>
    <SolidColorBrush x:Key="InputBorderHover" Color="#BFCEE6"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#C9D5E8"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#A9BBD8"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F5FE0" Offset="0"/>
        <GradientStop Color="#1FA8D8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4674F0" Offset="0"/>
        <GradientStop Color="#2FBEE8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7A2F5FE0" Offset="0"/>
        <GradientStop Color="#3D1FA8D8" Offset="0.55"/>
        <GradientStop Color="#DCE4F2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarGlowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F4C7DFF" Offset="0"/>
        <GradientStop Color="#00000000" Offset="0.5"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1F4C7DFF" Offset="0"/>
        <GradientStop Color="#00F3F6FC" Offset="1"/>
    </RadialGradientBrush>
</ResourceDictionary>
